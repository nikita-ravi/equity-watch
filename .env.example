# SEC EDGAR requires a contact address in the User-Agent on every request.
# Required -- ingest fails without it.
SEC_IDENTITY=Your Name you@example.com

# Groq — free tier, no credit card: https://console.groq.com/keys
GROQ_API_KEY=gsk_...

# LangSmith — free tier: https://smith.langchain.com/settings
LANGCHAIN_API_KEY=lsv2_pt_...
LANGCHAIN_TRACING_V2=true
LANGCHAIN_PROJECT=sec-rag-agent

# Optional: override the Groq model
# GROQ_MODEL=llama-3.3-70b-versatile
